# Appearance
theme = mono
background = #0A0B0A
background-opacity = 1
background-blur = false

# Font
font-size = 14

# Cursor
cursor-style = block
cursor-style-blink = false

# Window chrome / layout
macos-titlebar-style = tabs
macos-window-buttons = hidden
window-decoration = auto
window-padding-balance = true
window-padding-x = 20
window-padding-y = 20
window-save-state = always
window-step-resize = true
window-new-tab-position = current
window-show-tab-bar = auto
resize-overlay = after-first

# Splits / panes
unfocused-split-opacity = 1
split-divider-color = #2A2A32
focus-follows-mouse = false

# Input / mouse
macos-option-as-alt = true
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:1,discrete:2
scroll-to-bottom = keystroke,no-output

# Clipboard / links
clipboard-read = allow
clipboard-write = allow
link-previews = true

# Behavior
confirm-close-surface = false
shell-integration-features = no-cursor,sudo,ssh-terminfo,ssh-env

# Native pane navigation
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right

# Native pane resize
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+j=resize_split:down,10
keybind = ctrl+shift+k=resize_split:up,10
keybind = ctrl+shift+l=resize_split:right,10
