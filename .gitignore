.DS_Store
__pycache__/

# Nix build output and Home Manager backups
/result
result-*
*.hm-backup

# Application state in writable config directories
config/karabiner/automatic_backups/
config/gh/hosts.yml
*.log

# Credentials must never enter this repository.
*.env
*.pem
*.key
*.token
*secret*
*credentials*
*password*
# 1Password's agent skill and MCP wrapper hold no credentials.
!*1password-environments
!executable_fx-1password-mcp
