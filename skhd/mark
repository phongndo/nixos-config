#!/bin/bash
# One-off app mark for skhd.
# usage: mark set   remember the frontmost app
#        mark jump  focus it again, like the app keys

set -u

mark_file="${XDG_CACHE_HOME:-$HOME/.cache}/skhd/mark"

case ${1:-} in
  set)
    # Record the bundle id and path so a quit app relaunches from the same copy.
    info=$(/usr/bin/lsappinfo info -only bundleid -only bundlepath "$(/usr/bin/lsappinfo front)" 2>/dev/null)
    case $info in
      *'"CFBundleIdentifier"="'*) ;;
      *) exit 1 ;;
    esac
    bundle_id=${info#*\"CFBundleIdentifier\"=\"}
    bundle_id=${bundle_id%%\"*}
    app_path=
    case $info in
      *'"LSBundlePath"="'*)
        app_path=${info#*\"LSBundlePath\"=\"}
        app_path=${app_path%%\"*}
        ;;
    esac

    mkdir -p "${mark_file%/*}"
    printf '%s\n%s\n' "$bundle_id" "$app_path" >"$mark_file"
    ;;
  jump)
    [ -r "$mark_file" ] || exit 0
    { read -r bundle_id; read -r app_path; } <"$mark_file"
    exec "${0%/*}/focus-app" "$bundle_id" ${app_path:+"$app_path"}
    ;;
  *)
    echo "usage: mark set|jump" >&2
    exit 2
    ;;
esac
