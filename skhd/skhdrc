# AeroSpace-like yabai bindings.
# App bindings focus/open the requested app only; no same-app window cycling.
# Keep high-frequency yabai hotkeys direct and quiet. skhd already runs each
# command through a shell; extra wrapper scripts and query+jq paths add latency.
# App keys accept that cost (about 10 ms) to stay on the current Space.
# In stack layout, use alt-tab/shift-alt-tab to move within the stack.
# Alt-h/j/k/l is reserved for terminal applications such as Frame.

# Layout. Stack gives one full-screen managed window at a time; BSP gives splits.
alt - 0x2C : yabai -m space --layout bsp >/dev/null 2>&1
alt - 0x2B : yabai -m space --layout stack >/dev/null 2>&1

# Focus.
alt - tab         : yabai -m window --focus stack.next >/dev/null 2>&1
alt + shift - tab : yabai -m window --focus stack.prev >/dev/null 2>&1

# Spaces (yabai index on current display; 1-based). Missing/already-focused
# spaces are quiet no-ops.
alt - 1 : yabai -m space --focus 1 >/dev/null 2>&1
alt - 2 : yabai -m space --focus 2 >/dev/null 2>&1
alt - 3 : yabai -m space --focus 3 >/dev/null 2>&1
alt - 4 : yabai -m space --focus 4 >/dev/null 2>&1
alt - 5 : yabai -m space --focus 5 >/dev/null 2>&1
alt - 6 : yabai -m space --focus 6 >/dev/null 2>&1
alt - 7 : yabai -m space --focus 7 >/dev/null 2>&1
alt - 8 : yabai -m space --focus 8 >/dev/null 2>&1
alt - 9 : yabai -m space --focus 9 >/dev/null 2>&1
alt - 0 : yabai -m space --focus 10 >/dev/null 2>&1
alt + shift - 1 : yabai -m window --space 1 >/dev/null 2>&1 && yabai -m space --focus 1 >/dev/null 2>&1
alt + shift - 2 : yabai -m window --space 2 >/dev/null 2>&1 && yabai -m space --focus 2 >/dev/null 2>&1
alt + shift - 3 : yabai -m window --space 3 >/dev/null 2>&1 && yabai -m space --focus 3 >/dev/null 2>&1
alt + shift - 4 : yabai -m window --space 4 >/dev/null 2>&1 && yabai -m space --focus 4 >/dev/null 2>&1
alt + shift - 5 : yabai -m window --space 5 >/dev/null 2>&1 && yabai -m space --focus 5 >/dev/null 2>&1
alt + shift - 6 : yabai -m window --space 6 >/dev/null 2>&1 && yabai -m space --focus 6 >/dev/null 2>&1
alt + shift - 7 : yabai -m window --space 7 >/dev/null 2>&1 && yabai -m space --focus 7 >/dev/null 2>&1
alt + shift - 8 : yabai -m window --space 8 >/dev/null 2>&1 && yabai -m space --focus 8 >/dev/null 2>&1
alt + shift - 9 : yabai -m window --space 9 >/dev/null 2>&1 && yabai -m space --focus 9 >/dev/null 2>&1
alt + shift - 0 : yabai -m window --space 10 >/dev/null 2>&1 && yabai -m space --focus 10 >/dev/null 2>&1

# Move/reorder.
alt + shift - h : yabai -m window --swap west >/dev/null 2>&1
alt + shift - j : yabai -m window --swap south >/dev/null 2>&1
alt + shift - k : yabai -m window --swap north >/dev/null 2>&1
alt + shift - l : yabai -m window --swap east >/dev/null 2>&1

# Resize.
alt + shift - 0x1B : yabai -m window --ratio rel:-0.05 >/dev/null 2>&1
alt + shift - 0x18 : yabai -m window --ratio rel:0.05 >/dev/null 2>&1

# Opt the focused window into/out of tiling.
alt + shift - space : yabai -m window --toggle float >/dev/null 2>&1

# App-first jumps. Focus the app's frontmost window on the current Space; with
# no window here, front the app wherever it is, or launch it.
alt - 0x29      : ~/.config/skhd/focus-app com.superlogical.rex
alt - c         : ~/.config/skhd/focus-app com.openai.codex
alt - f         : ~/.config/skhd/focus-app net.imput.helium
alt - s         : ~/.config/skhd/focus-app com.tinyspeck.slackmacgap
alt - t         : ~/.config/skhd/focus-app com.t3tools.t3code '/Applications/T3 Code (Nightly).app'
alt - p         : ~/.config/skhd/focus-app com.spotify.client
alt - m         : ~/.config/skhd/focus-app com.apple.MobileSMS
alt - e         : ~/.config/skhd/focus-app com.apple.finder
alt - i         : ~/.config/skhd/focus-app com.fastmail.mac.Fastmail
alt - o         : ~/.config/skhd/focus-app md.obsidian

# Fast previous-app toggle.
alt - q : set -- $(/usr/bin/lsappinfo -nonames visibleProcessList 2>/dev/null); [ $# -ge 2 ] && /usr/bin/lsappinfo requestfront "$2" --immediate >/dev/null 2>&1

# AeroSpace service-mode equivalents as direct bindings.
alt + shift - 0x29      : yabai -m space --balance >/dev/null 2>&1
alt + shift - f         : yabai -m window --toggle zoom-fullscreen >/dev/null 2>&1
alt + shift - backspace : yabai -m window --close >/dev/null 2>&1

# One-off app mark. Alt-Shift-M remembers the focused app; Alt-' focuses it
# the same way as the app keys above.
alt + shift - m : ~/.config/skhd/mark set
alt - 0x27      : ~/.config/skhd/mark jump
