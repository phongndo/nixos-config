mark < h : skhd -k escape; ~/.config/skhd/mark set h
mark < i : skhd -k escape; ~/.config/skhd/mark set i
mark < j : skhd -k escape; ~/.config/skhd/mark set j
mark < k : skhd -k escape; ~/.config/skhd/mark set k
mark < l : skhd -k escape; ~/.config/skhd/mark set l
mark < m : skhd -k escape; ~/.config/skhd/mark set m
mark < n : skhd -k escape; ~/.config/skhd/mark set n
mark < o : skhd -k escape; ~/.config/skhd/mark set o
mark < p : skhd -k escape; ~/.config/skhd/mark set p
mark < q : skhd -k escape; ~/.config/skhd/mark set q
mark < r : skhd -k escape; ~/.config/skhd/mark set r
mark < s : skhd -k escape; ~/.config/skhd/mark set s
mark < t : skhd -k escape; ~/.config/skhd/mark set t
