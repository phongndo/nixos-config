#!/bin/sh

set -eu

repo=$(
  unset CDPATH
  cd -- "$(dirname -- "$0")/.."
  pwd
)

if [ "$(uname -s)" != Darwin ]; then
  echo "bootstrap: this script only supports macOS" >&2
  exit 1
fi

if [ "$(id -un)" != dp ]; then
  echo "bootstrap: expected the macOS user to be dp" >&2
  exit 1
fi

for command in nix brew; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "bootstrap: install $command first" >&2
    exit 1
  fi
done

cd "$repo"
system_path=$(nix build --no-link --print-out-paths .#darwinConfigurations.y.system)
sudo "$system_path/sw/bin/darwin-rebuild" switch --flake "$repo#y"
