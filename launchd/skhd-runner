#!/bin/sh
# LaunchAgent wrapper for skhd.
# Retries startup failures such as Secure Keyboard Entry being held briefly by
# loginwindow at login, and restarts skhd if it crashes.

USER_PROFILE="/etc/profiles/per-user/${USER:-${HOME##*/}}"
PATH="$USER_PROFILE/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# skhd executes bindings through "$SHELL -c". Pin this to bash so hotkey
# latency cannot regress if launchd inherits zsh/fish or a future shell startup
# file gets expensive.
SHELL="/bin/bash"
export SHELL

SKHD_BIN="${SKHD_BIN:-$USER_PROFILE/bin/skhd}"
SKHD_CONFIG="$HOME/.config/skhd/skhdrc"
RETRY_DELAY="${RETRY_DELAY:-5}"
child=""

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >&2
}

stop_child() {
  if [ -n "${child:-}" ]; then
    kill "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
  fi
}

terminate() {
  stop_child
  exit 0
}

trap terminate INT TERM

while :; do
  log "starting skhd"
  "$SKHD_BIN" -c "$SKHD_CONFIG" &
  child=$!
  wait "$child"
  status=$?
  child=""

  # Some macOS startup failures (notably Accessibility/Input Monitoring not
  # being ready yet) can make daemons exit with status 0. A clean exit is not
  # useful here: skhd is expected to remain alive, while intentional shutdown
  # is handled by the TERM/INT trap above. Retry every unexpected exit.
  if [ "$status" -eq 0 ]; then
    log "skhd exited; restarting in ${RETRY_DELAY}s"
  else
    log "skhd exited with status $status; restarting in ${RETRY_DELAY}s"
  fi

  sleep "${RETRY_DELAY}" &
  child=$!
  wait "$child" || exit 0
  child=""
done
