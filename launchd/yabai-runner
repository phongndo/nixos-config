#!/bin/sh
# LaunchAgent wrapper for yabai.
# Keeps launchd alive while retrying startup failures that commonly happen
# during login, before Accessibility is ready, or after a crash.

USER_PROFILE="/etc/profiles/per-user/${USER:-${HOME##*/}}"
PATH="$USER_PROFILE/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

YABAI_BIN="${YABAI_BIN:-$USER_PROFILE/bin/yabai}"
YABAI_CONFIG="$HOME/.config/yabai/yabairc"
RETRY_DELAY="${RETRY_DELAY:-5}"
child=""

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >&2
}

stop_child() {
  if [ -n "${child:-}" ]; then
    kill "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
  fi
}

terminate() {
  stop_child
  exit 0
}

trap terminate INT TERM

while :; do
  log "starting yabai"
  # Keep yabai quiet by default. --verbose/debug_output logs every window and
  # mouse event; with StandardOutPath set this can grow huge and make dragging
  # and focus changes feel laggy. Temporarily run with YABAI_VERBOSE=1 when
  # actively debugging.
  if [ "${YABAI_VERBOSE:-0}" = "1" ]; then
    "$YABAI_BIN" --config "$YABAI_CONFIG" --verbose &
  else
    "$YABAI_BIN" --config "$YABAI_CONFIG" &
  fi
  child=$!
  wait "$child"
  status=$?
  child=""

  if [ "$status" -eq 0 ]; then
    log "yabai exited; restarting in ${RETRY_DELAY}s"
  else
    log "yabai exited with status $status; restarting in ${RETRY_DELAY}s"
  fi

  sleep "${RETRY_DELAY}" &
  child=$!
  wait "$child" || exit 0
  child=""
done
