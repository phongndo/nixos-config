{{- /* chezmoi:modify-template */ -}}
{{- /* GitHub Copilot's app and CLI read MCP servers from here. Own only the
      Executor entry; servers added with `/mcp add` stay as written. */ -}}
{{- $current := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $merged := deepCopy $current -}}
{{- $servers := get $merged "mcpServers" | default dict -}}
{{- $_ := set $servers "executor" (dict "type" "local" "command" (joinPath .chezmoi.homeDir ".local/bin/executor-token") "args" (list "mcp") "tools" (list "skills" "search" "describe" "execute" "resume")) -}}
{{- $_ := set $merged "mcpServers" $servers -}}
{{- if eq ($current | toJson) ($merged | toJson) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{ $merged | toPrettyJson }}
{{- end -}}
