{{- /* chezmoi:modify-template */ -}}
{{- /* Seed shared preferences, preserve machine-local settings, and enforce
      auto memory and commit/PR attribution off and the Bash tool's shell. */ -}}
{{- $current := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $merged := mustMergeOverwrite (dict "theme" "dark" "permissions" (dict "defaultMode" "bypassPermissions") "skipDangerousModePermissionPrompt" true) (deepCopy $current) -}}
{{- $_ := set $merged "autoMemoryEnabled" false -}}
{{- $_ := set $merged "attribution" (dict "commit" "" "pr" "") -}}
{{- /* Run the Bash tool with Nix bash on both hosts. */ -}}
{{- $env := get $merged "env" | default dict -}}
{{- $_ := set $env "CLAUDE_CODE_SHELL" (printf "/etc/profiles/per-user/%s/bin/bash" .chezmoi.username) -}}
{{- $_ := set $merged "env" $env -}}
{{- /* Use the managed code-mode bridge in Claude Code, while leaving the
      account-level Executor connector available to Claude chat. */ -}}
{{- $denied := get $merged "deniedMcpServers" | default (list) -}}
{{- $hasExecutor := false -}}
{{- range $denied -}}
{{- if eq (get . "serverName") "claude.ai Executor" -}}
{{- $hasExecutor = true -}}
{{- end -}}
{{- end -}}
{{- if not $hasExecutor -}}
{{- $denied = append $denied (dict "serverName" "claude.ai Executor") -}}
{{- end -}}
{{- $_ := set $merged "deniedMcpServers" $denied -}}
{{- /* Keep computer use on in every project; it needs macOS. */ -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $command := joinPath .chezmoi.homeDir ".local/bin/claude-computer-use" -}}
{{-   $hooks := get $merged "hooks" | default dict -}}
{{-   $sessionStart := get $hooks "SessionStart" | default (list) -}}
{{-   $hasHook := false -}}
{{-   range $sessionStart -}}
{{-     range (get . "hooks" | default (list)) -}}
{{-       if eq (get . "command") $command -}}
{{-         $hasHook = true -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if not $hasHook -}}
{{-     $sessionStart = append $sessionStart (dict "hooks" (list (dict "type" "command" "command" $command "timeout" 5))) -}}
{{-     $_ := set $hooks "SessionStart" $sessionStart -}}
{{-     $_ := set $merged "hooks" $hooks -}}
{{-   end -}}
{{- end -}}
{{- if eq ($current | toJson) ($merged | toJson) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{ $merged | toPrettyJson }}
{{- end -}}
