{{- /* chezmoi:modify-template */ -}}
{{- /* Seed shared preferences, preserve machine-local settings, and enforce
      the GitHub Dark High Contrast theme
      (themes/github-dark-high-contrast.json), auto memory and commit/PR
      attribution off, and the Bash tool's shell. */ -}}
{{- $current := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $merged := mustMergeOverwrite (dict "permissions" (dict "defaultMode" "bypassPermissions") "skipDangerousModePermissionPrompt" true) (deepCopy $current) -}}
{{- $_ := set $merged "theme" "custom:github-dark-high-contrast" -}}
{{- $_ := set $merged "autoMemoryEnabled" false -}}
{{- $_ := set $merged "attribution" (dict "commit" "" "pr" "") -}}
{{- /* Run the Bash tool with Nix bash on both hosts. */ -}}
{{- $env := get $merged "env" | default dict -}}
{{- $_ := set $env "CLAUDE_CODE_SHELL" (printf "/etc/profiles/per-user/%s/bin/bash" .chezmoi.username) -}}
{{- $_ := set $merged "env" $env -}}
{{- /* Use the managed code-mode bridge in Claude Code, while leaving the
      account-level Executor connector available to Claude chat. */ -}}
{{- $denied := get $merged "deniedMcpServers" | default (list) -}}
{{- $hasExecutor := false -}}
{{- range $denied -}}
{{- if eq (get . "serverName") "claude.ai Executor" -}}
{{- $hasExecutor = true -}}
{{- end -}}
{{- end -}}
{{- if not $hasExecutor -}}
{{- $denied = append $denied (dict "serverName" "claude.ai Executor") -}}
{{- end -}}
{{- $_ := set $merged "deniedMcpServers" $denied -}}
{{- /* Service actions go through Executor's `execute`; hide its direct `call`
      tool, as Codex does with disabled_tools. */ -}}
{{- $permissions := get $merged "permissions" | default dict -}}
{{- $deny := get $permissions "deny" | default (list) -}}
{{- if not (has "mcp__executor__call" $deny) -}}
{{-   $deny = append $deny "mcp__executor__call" -}}
{{- end -}}
{{- $_ := set $permissions "deny" $deny -}}
{{- $_ := set $merged "permissions" $permissions -}}
{{- /* Rex's own SessionStart hook (see run_after_sync-rex-agents) is silent
      outside a Rex terminal; add one that says how to use Rex there. */ -}}
{{- $merged = includeTemplate "rex-outside-hook.tmpl" $merged | fromJson -}}
{{- if eq ($current | toJson) ($merged | toJson) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{ $merged | toPrettyJson }}
{{- end -}}
