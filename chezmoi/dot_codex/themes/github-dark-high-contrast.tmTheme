<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GitHub Dark High Contrast (Primer prettylights). No background: Codex draws on the terminal's. -->
<plist version="1.0">
<dict>
  <key>name</key><string>GitHub Dark High Contrast</string>
  <key>settings</key>
  <array>
    <dict><key>settings</key><dict><key>foreground</key><string>#f0f3f6</string><key>caret</key><string>#71b7ff</string><key>selection</key><string>#20456c</string><key>lineHighlight</key><string>#14171b</string></dict></dict>
    <dict><key>name</key><string>Comment</string><key>scope</key><string>comment, punctuation.definition.comment, string.comment</string><key>settings</key><dict><key>foreground</key><string>#bdc4cc</string></dict></dict>
    <dict><key>name</key><string>Constant</string><key>scope</key><string>constant, entity.name.constant, variable.other.constant, variable.other.enummember, variable.language, entity, support.constant, meta.property-name, support.variable, meta.module-reference</string><key>settings</key><dict><key>foreground</key><string>#91cbff</string></dict></dict>
    <dict><key>name</key><string>Entity</string><key>scope</key><string>entity.name, meta.export.default, meta.definition.variable, entity.name.function, support.function</string><key>settings</key><dict><key>foreground</key><string>#dbb7ff</string></dict></dict>
    <dict><key>name</key><string>Plain</string><key>scope</key><string>variable.parameter.function, meta.jsx.children, meta.block, meta.tag.attributes, entity.name.constant, meta.object.member, meta.embedded.expression, storage.modifier.package, storage.modifier.import, storage.type.java</string><key>settings</key><dict><key>foreground</key><string>#f0f3f6</string></dict></dict>
    <dict><key>name</key><string>Tag</string><key>scope</key><string>entity.name.tag, support.class.component</string><key>settings</key><dict><key>foreground</key><string>#72f088</string></dict></dict>
    <dict><key>name</key><string>Keyword</string><key>scope</key><string>keyword, storage, storage.type</string><key>settings</key><dict><key>foreground</key><string>#ff9492</string></dict></dict>
    <dict><key>name</key><string>String</string><key>scope</key><string>string, punctuation.definition.string, string punctuation.section.embedded source</string><key>settings</key><dict><key>foreground</key><string>#addcff</string></dict></dict>
    <dict><key>name</key><string>Variable</string><key>scope</key><string>variable, entity.name.type, support.type, support.class, entity.other.inherited-class</string><key>settings</key><dict><key>foreground</key><string>#ffb757</string></dict></dict>
    <dict><key>name</key><string>Regexp</string><key>scope</key><string>string.regexp, constant.character.escape</string><key>settings</key><dict><key>foreground</key><string>#72f088</string></dict></dict>
    <dict><key>name</key><string>Heading</string><key>scope</key><string>markup.heading, markup.heading entity.name</string><key>settings</key><dict><key>foreground</key><string>#409eff</string></dict></dict>
    <dict><key>name</key><string>List</string><key>scope</key><string>punctuation.definition.list.begin.markdown</string><key>settings</key><dict><key>foreground</key><string>#fbd669</string></dict></dict>
    <dict><key>name</key><string>Inserted</string><key>scope</key><string>markup.inserted, meta.diff.header.to-file, punctuation.definition.inserted</string><key>settings</key><dict><key>foreground</key><string>#26cd4d</string></dict></dict>
    <dict><key>name</key><string>Deleted</string><key>scope</key><string>markup.deleted, meta.diff.header.from-file, punctuation.definition.deleted</string><key>settings</key><dict><key>foreground</key><string>#ff6a69</string></dict></dict>
    <dict><key>name</key><string>Changed</string><key>scope</key><string>markup.changed, punctuation.definition.changed</string><key>settings</key><dict><key>foreground</key><string>#f0b72f</string></dict></dict>
    <dict><key>name</key><string>Range</string><key>scope</key><string>meta.diff.range</string><key>settings</key><dict><key>foreground</key><string>#dbb7ff</string></dict></dict>
    <dict><key>name</key><string>Invalid</string><key>scope</key><string>invalid.broken, invalid.deprecated, invalid.illegal, invalid.unimplemented</string><key>settings</key><dict><key>foreground</key><string>#ff6a69</string></dict></dict>
  </array>
</dict>
</plist>
