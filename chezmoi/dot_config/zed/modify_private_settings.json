#!/usr/bin/env python3
"""Merge Executor and the GitHub Dark High Contrast theme into Zed's JSONC
settings, preserving all other settings."""
import json
from pathlib import Path
import sys


def trivia_end(text, index):
    while index < len(text):
        if text[index].isspace():
            index += 1
        elif text.startswith("//", index):
            end = text.find("\n", index + 2)
            index = len(text) if end < 0 else end
        elif text.startswith("/*", index):
            end = text.find("*/", index + 2)
            if end < 0:
                raise ValueError("Unterminated JSONC comment")
            index = end + 2
        else:
            break
    return index


def parse_jsonc(text):
    text = text.removeprefix("\ufeff")
    decoder = json.JSONDecoder()
    result = []
    index = 0
    while index < len(text):
        end = trivia_end(text, index)
        if end != index:
            result.append(" ")
            index = end
        elif text[index] == '"':
            _, end = decoder.raw_decode(text, index)
            result.append(text[index:end])
            index = end
        elif text[index] == "," and text[trivia_end(text, index + 1):][:1] in ("}", "]"):
            index += 1
        else:
            result.append(text[index])
            index += 1
    return json.loads("".join(result))


original = sys.stdin.read()
settings = parse_jsonc(original or "{}")
before = json.dumps(settings, sort_keys=True)
entry = {"command": str(Path.home() / ".local/bin/executor-token"), "args": ["mcp"], "env": {}}
settings.setdefault("context_servers", {})["executor"] = entry
# The github-theme extension provides it. Zed is a window rather than a
# terminal, so it keeps the theme's own background (#0a0c10), which is close
# to Rex's.
settings["theme"] = "GitHub Dark High Contrast"
settings.setdefault("auto_install_extensions", {})["github-theme"] = True
if json.dumps(settings, sort_keys=True) == before:
    sys.stdout.write(original)
else:
    sys.stdout.write(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
