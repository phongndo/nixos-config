// Managed by nix-config. OpenCode keeps its own settings in opencode.json;
// this file takes precedence for the keys below.
{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/etc/profiles/per-user/{{ .chezmoi.username }}/bin/bash",
{{- if eq .chezmoi.os "darwin" }}
  // Claude Code and Codex get these skills and the 1Password server from
  // plugins; OpenCode has none. The server runs in 1Password's desktop app.
  "skills": ["{{ .chezmoi.homeDir }}/.agents/plugin-skills"],
{{- end }}
  "mcp": {
    "servers": {
      "executor": {
        "type": "local",
        "command": ["{{ .chezmoi.homeDir }}/.local/bin/executor-mcp"],
        "timeout": { "catalog": 30000, "execution": 30000 },
        "codemode": true
      }
{{- if eq .chezmoi.os "darwin" }},
      "1password": {
        "type": "local",
        "command": ["1password-mcp"]
      }
{{- end }}
    }
  }
}
