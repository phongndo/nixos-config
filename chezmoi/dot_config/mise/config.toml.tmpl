[settings]
all_compile = false
minimum_release_age = "0s"

[settings.npm]
package_manager = "npm"

[tools]
# Agent tools intentionally track latest independently of the Nix generation.
codex = "latest"
claude = "latest"
antigravity-cli = "latest"
python = "3.15"
"npm:@opencode/cli" = { version = "latest", allow_builds = ["@opencode/cli"] }
pi = "latest"
# Manual: on each host, run `fx login codex`.
"github:vercel-labs/fx" = "latest"
node = "26"
# Executor's own CLI serves Executor Cloud to every agent: `executor mcp`,
# run through ~/.local/bin/executor-token, is their stdio MCP server. Pinned
# because the 2.x line is a fast-moving beta; bump deliberately. Manual: on
# each host, save an Executor access token as `executor-token` describes.
# Connect provider accounts at https://app.executor.sh/org/phony.
"npm:executor" = "2.0.0-beta.60"
# Personal tools follow published releases independently of Nix.
"github:phongndo/mark" = "latest"
"github:phongndo/hz" = "latest"
"github:phongndo/frame" = "latest"
{{ if eq .chezmoi.os "darwin" -}}
"github:phongndo/leetvim" = "latest"
{{ end -}}
