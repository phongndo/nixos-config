[settings]
all_compile = false
minimum_release_age = "0s"

[settings.npm]
package_manager = "npm"

[tools]
# Agent tools intentionally track latest independently of the Nix generation.
codex = "latest"
claude = "latest"
python = "3.14"
opencode = "latest"
pi = "latest"
node = "26"
{{ if eq .chezmoi.os "linux" -}}
# macOS uses Executor.app.
"npm:executor" = "latest"
{{ end -}}
herdr = "latest"
