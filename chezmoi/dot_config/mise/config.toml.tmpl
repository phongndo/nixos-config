[settings]
all_compile = false
minimum_release_age = "0s"

[settings.npm]
package_manager = "npm"

[tools]
# Agent tools intentionally track latest independently of the Nix generation.
codex = "latest"
claude = "latest"
python = "3.15"
"npm:@opencode/cli" = { version = "latest", allow_builds = ["@opencode/cli"] }
pi = "latest"
# Manual: on each host, run `fx login codex`.
"github:vercel-labs/fx" = "latest"
node = "26"
"npm:mcp-remote" = "latest"
# Personal tools follow published releases independently of Nix.
"github:phongndo/mark" = "latest"
"github:phongndo/hz" = "latest"
"github:phongndo/frame" = "latest"
{{ if eq .chezmoi.os "darwin" -}}
"github:phongndo/leetvim" = "latest"
{{ end -}}

# Devin publishes no GitHub releases or npm package, so read its own manifest.
# Manual: on each host, run `devin auth login`.
[tools."http:devin"]
version = "latest"
version_list_url = "https://static.devin.ai/cli/current/manifest.json"
version_json_path = ".version"
bin_path = "bin"
url = '{{ `https://static.devin.ai/cli/{{ version }}/devin-{{ version }}-{{ arch(x64="x86_64", arm64="aarch64") }}-{{ os(macos="apple-darwin", linux="unknown-linux") }}.tar.gz` }}'
