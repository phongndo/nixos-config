[settings]
all_compile = false
minimum_release_age = "0s"

[settings.npm]
package_manager = "npm"

[tools]
codex = "latest"
claude = "latest"
python = "3.14"
opencode = "latest"
pi = "latest"
{{ if eq .chezmoi.os "linux" -}}
# Shared with home/deepseek-harness.nix: upgrades must not remove its runtime.
node = "{{ .harnessRuntime.node }}"
"npm:@deepseek-ai/dsh" = "{{ .harnessRuntime.dsh }}"
# Required by `dsh plugin` to manage profile dependencies.
pnpm = "{{ .harnessRuntime.pnpm }}"
# macOS uses the Homebrew installation.
"npm:executor" = "latest"
{{ else -}}
node = "26"
"npm:@deepseek-ai/dsh" = "latest"
{{ end -}}
herdr = "latest"
