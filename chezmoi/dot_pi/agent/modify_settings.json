{{- /* chezmoi:modify-template */ -}}
{{- /* Pi writes preferences and runtime state here. Seed missing defaults,
      preserve local choices (including false/empty values), and keep the
      package list managed so shared extension changes still reach both hosts. */ -}}
{{- $current := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $defaults := includeTemplate "pi-settings.json.tmpl" . | fromJson -}}
{{- $merged := mustMergeOverwrite (deepCopy $defaults) $current (dict "packages" $defaults.packages) -}}
{{- if eq ($current | toJson) ($merged | toJson) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{ $merged | toPrettyJson }}
{{- end -}}
