            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          }
        },
        {
          "id": "gpt-5.4",
          "name": "GPT-5.4 (Local Codex)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000,
          "maxTokens": 128000,
          "thinkingLevelMap": {
            "minimal": "low",
            "xhigh": "xhigh"
          }
        }
      ]
    }
  }
}
