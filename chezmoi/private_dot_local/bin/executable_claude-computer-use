#!/usr/bin/env bash
# Claude Code turns its built-in computer-use server on per project, in
# ~/.claude.json, and has no global switch. Its SessionStart hook runs this to
# turn the server on in every project; Claude Code reloads the file when it
# changes. Nothing is written once every project has it.
set -euo pipefail
config="$HOME/.claude.json"
jq="/etc/profiles/per-user/$(id -un)/bin/jq"
[[ -s "$config" && -x "$jq" ]] || exit 0
missing='any(.projects[]?; (.enabledMcpServers // []) | index("computer-use") | not)'
"$jq" -e "$missing" "$config" >/dev/null || exit 0
umask 077
tmp=$(mktemp "$config.XXXXXX")
trap 'rm -f "$tmp"' EXIT
"$jq" '.projects |= map_values(.enabledMcpServers = ((.enabledMcpServers // [])
  | if index("computer-use") then . else . + ["computer-use"] end))' "$config" >"$tmp"
mv "$tmp" "$config"
