#!/run/current-system/sw/bin/bash
# Linux agents use this host's own Executor daemon and connection store.
# mise supplies Node and the npm-installed executor even from a restricted PATH.
set -euo pipefail
exec "/etc/profiles/per-user/$(/run/current-system/sw/bin/id -un)/bin/mise" -C "$HOME" exec -- \
  executor mcp --scope "$HOME/.executor" \
  --no-artifacts --search-tools --elicitation-mode browser
