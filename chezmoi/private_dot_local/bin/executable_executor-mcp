#!/usr/bin/env bash
# All agents use the same Executor Cloud workspace. OAuth client credentials
# stay in mcp-remote's local store; provider credentials stay in Executor Cloud.
# Service actions use execute; discovery and approval/resume tools stay available.
set -euo pipefail
umask 077
client=mcp-remote
if [[ "${1:-}" == --login ]]; then
  client=mcp-remote-client
  shift
fi
if [[ "$(uname -s)" == Darwin ]]; then
  callback=(3337)
else
  callback=(3338 --host 127.0.0.1)
fi
exec "/etc/profiles/per-user/$(id -un)/bin/mise" -C "$HOME" exec -- \
  "$client" https://mcp.executor.sh/mcp "${callback[@]}" \
  --transport http-only --auth-timeout 900 --ignore-tool call "$@"
