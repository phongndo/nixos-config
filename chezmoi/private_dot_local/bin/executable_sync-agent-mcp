#!/usr/bin/env python3
"""Reconcile managed MCP entries for the agent harnesses on macOS and Linux.

Called after chezmoi applies native configs.
Executor uses the shared Cloud workspace through mcp-remote on each host.
Radius is Pi-only; Rex control uses its separately installed CLI skill.
Cloud client sign-ins stay local; provider accounts are held by Executor Cloud.
Python 3.11+ is required.
"""
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import tomllib


RETIRED_REX_COMMUNITY_URL = "https://www.superlogical.com/rex/community-mcp"
RADIUS_URL = "https://radius.pi.dev/mcp"


def remove_rex_community(text, key="mcpServers"):
    data = json.loads(text) if text.strip() else {}
    # Remove only the community endpoint we previously installed. A custom
    # server using the same name belongs to the user. Include legacy maps so
    # an old entry cannot override or resurrect the retired connection.
    for map_key in {key, "mcpServers"}:
        servers = data.get(map_key, {})
        for mapping in (servers, servers.get("servers", {})):
            if mapping.get("superlogical", {}).get("url") == RETIRED_REX_COMMUNITY_URL:
                del mapping["superlogical"]
    if text.strip() and json.loads(text) == data:
        return text
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def pi_config(text, entry):
    data = json.loads(text) if text.strip() else {}
    servers = data.setdefault("mcpServers", {})
    executor = dict(servers.get("executor", {}))
    # Migrate the custom extension's toggle once; native Pi owns enabled from here on.
    if "disabled" in executor:
        executor["enabled"] = not executor.pop("disabled")
    # Replace the managed connection, not Pi's mutable exposure/toggle/timeout settings.
    for key in ("type", "env", "cwd", "url", "headers", "oauth"):
        executor.pop(key, None)
    executor.update(entry)
    # Executor already provides discovery and sandboxed execution; avoid nesting it
    # behind Pi's codemode by default. Preserve later choices made through /mcp.
    executor.setdefault("exposure", "direct")
    servers["executor"] = executor
    radius = dict(servers.get("radius", {}))
    radius["url"] = RADIUS_URL
    radius["auth"] = {**radius.get("auth", {}), "provider": "radius"}
    servers["radius"] = radius
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def fx_config(text, entry):
    data = json.loads(text) if text.strip() else {}
    # fx prefers mcp over its legacy mcpServers key. Carry legacy servers into
    # the preferred map when adding it so they remain available.
    servers = data.setdefault("mcp", dict(data.get("mcpServers", {})))
    executor = dict(servers.get("executor", {}))
    for key in ("env", "environment", "cwd", "url", "headers", "header_env", "bearer_token_env", "oauth"):
        executor.pop(key, None)
    executor.update({"type": "local", **entry})
    servers["executor"] = executor
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def json_executor_config(text, entry, key="mcpServers", transport="stdio", command_list=False):
    data = json.loads(text) if text.strip() else {}
    servers = data.setdefault(key, {})
    if command_list and "servers" in servers:
        servers = servers["servers"]
    executor = dict(servers.get("executor", {}))
    for field in ("command", "args", "env", "environment", "cwd", "url", "headers", "oauth"):
        executor.pop(field, None)
    executor.update({"type": transport, **entry})
    if command_list:
        executor["command"] = [entry["command"], *entry.get("args", [])]
        executor.pop("args", None)
    servers["executor"] = executor
    if text.strip() and json.loads(text) == data:
        return text
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def toml_value(value):
    if isinstance(value, dict):
        return "{ " + ", ".join(
            f"{json.dumps(key)} = {toml_value(item)}" for key, item in value.items()
        ) + " }"
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    return json.dumps(value, ensure_ascii=False)


def toml_config(text, entry, name="executor"):
    before = tomllib.loads(text)
    if entry is None:
        if before.get("mcp_servers", {}).get(name, {}).get("url") != RETIRED_REX_COMMUNITY_URL:
            return text
    else:
        server = dict(before.get("mcp_servers", {}).get(name, {}))
        for field in ("command", "args", "env", "env_vars", "cwd", "url", "http_headers", "env_http_headers", "bearer_token_env_var", "oauth"):
            server.pop(field, None)
        entry = {**server, **entry}
    if before.get("mcp_servers", {}).get(name) == entry:
        return text
    expected = dict(before)
    expected["mcp_servers"] = dict(before.get("mcp_servers", {}))
    if entry is None:
        expected["mcp_servers"].pop(name)
    else:
        expected["mcp_servers"][name] = entry
    # Preserve all unrelated text, including comments and other servers.
    # Validation below refuses unusual table spellings/multiline TOML rather
    # than silently changing settings outside the managed server.
    sections = re.split(r"(?m)(?=^[ \t]*\[)", text)
    server_table = re.compile(
        rf"^[ \t]*\[\s*mcp_servers\.(?:{name}|\"{name}\"|'{name}')(?:\s*\]|\.)"
    )
    kept = "".join(s for s in sections if not server_table.match(s)).rstrip()
    block = "\n" if entry is None else f"\n\n[mcp_servers.{name}]\n" + "".join(
        f"{key} = {toml_value(value)}\n"
        for key, value in entry.items()
    )
    result = kept + block
    parsed = tomllib.loads(result)
    if not expected["mcp_servers"] and "mcp_servers" not in parsed:
        expected.pop("mcp_servers")
    if parsed != expected:
        raise ValueError(f"cannot safely replace mcp_servers.{name}; no files changed")
    return result


def plan(home, platform="linux"):
    if platform not in ("darwin", "linux"):
        raise ValueError(f"unsupported platform: {platform}")
    stdio = {"command": str(home / ".local/bin/executor-mcp"), "args": []}
    changes = {}

    def patch(relative, transform):
        path = home / relative
        if path.is_symlink():
            raise ValueError(f"refusing to replace symlink: {path}")
        old = path.read_text() if path.exists() else ""
        try:
            new = transform(old)
        except (ValueError, TypeError, AttributeError) as error:
            raise ValueError(f"{path}: {error}") from error
        if new != old:
            changes[path] = (old, new)

    patch(".pi/agent/mcp.json", lambda old: remove_rex_community(pi_config(old, stdio)))
    patch(".codex/config.toml", lambda old: toml_config(
        toml_config(old, {**stdio, "startup_timeout_sec": 30}),
        None, "superlogical",
    ))
    patch(".fx/mcp.json", lambda old: remove_rex_community(fx_config(old, stdio), "mcp"))
    patch(".claude.json", lambda old: remove_rex_community(json_executor_config(old, stdio)))
    # OpenCode merges .json and .jsonc. Update a legacy executor entry in a
    # plain-JSON .jsonc too, since it takes precedence over the managed .json.
    patch(".config/opencode/opencode.json", lambda old: remove_rex_community(
        json_executor_config(old, stdio, "mcp", "local", command_list=True), "mcp",
    ))
    legacy = home / ".config/opencode/opencode.jsonc"
    if legacy.exists():
        text = legacy.read_text()
        try:
            data = json.loads(text)
        except json.JSONDecodeError:
            # Preserve ordinary commented settings. Do not silently leave a
            # managed executor override on the previous transport.
            if re.search(r'"executor"\s*:', text) or RETIRED_REX_COMMUNITY_URL in text:
                raise ValueError(f"{legacy}: move managed MCP entries to opencode.json before syncing")
        else:
            servers = data.get("mcp", {})
            servers = servers.get("servers", servers)
            def migrate_legacy(old):
                if "executor" in servers:
                    old = json_executor_config(old, stdio, "mcp", "local", command_list=True)
                return remove_rex_community(old, "mcp")
            patch(".config/opencode/opencode.jsonc", migrate_legacy)
    return changes


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(content)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def apply(home, platform="linux"):
    changes = plan(home, platform)  # Validate every existing file before writing any.
    backup_root = home / ".local/state/executor-agent-config/backups"
    if changes:
        backup_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    for path, (old, new) in changes.items():
        backup = backup_root / path.relative_to(home)
        if path.exists() and not backup.exists():
            atomic_write(backup, old)
        atomic_write(path, new)
        print(f"sync-agent-mcp: updated {path}")
    return len(changes)


if __name__ == "__main__":
    try:
        apply(Path.home(), sys.platform)
    except (OSError, ValueError) as error:
        print(f"sync-agent-mcp: {error}", file=sys.stderr)
        sys.exit(1)
