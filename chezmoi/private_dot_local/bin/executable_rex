#!/usr/bin/env bash
# Rex's bundled CLI is otherwise exposed only to terminals launched inside Rex.
set -euo pipefail
if [[ -n "${REX_BIN_DIR:-}" && -x "$REX_BIN_DIR/rex" && ! "$REX_BIN_DIR/rex" -ef "$0" ]]; then
  exec "$REX_BIN_DIR/rex" "$@"
fi
if [[ -x "/Applications/Rex.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex" ]]; then
  exec "/Applications/Rex.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex" "$@"
fi
exec "/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex" "$@"
