#!/usr/bin/env bash
# fx opens with MCP 2026-07-28's server/discover and switches to initialize
# when the server answers it with an error. 1Password's server exits on any
# first request but initialize, so answer that probe here, then hand stdin and
# stdout to the server.
set -euo pipefail
IFS= read -r request
id='"id":([0-9]+|"[^"]*")'
if [[ $request == *'"method":"server/discover"'* && $request =~ $id ]]; then
  printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"Method not found"}}\n' "${BASH_REMATCH[1]}"
  exec 1password-mcp "$@"
fi
{ printf '%s\n' "$request"; exec cat; } | exec 1password-mcp "$@"
