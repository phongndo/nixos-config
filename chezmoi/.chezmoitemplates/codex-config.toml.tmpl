approvals_reviewer = "user"
approval_policy = "never"
default_permissions = ":danger-full-access"
suppress_unstable_features_warning = true

# Codex themes only syntax highlighting; the rest of its UI uses the
# terminal's ANSI colors and background. The theme is
# themes/github-dark-high-contrast.tmTheme, which sets no background.
[tui]
theme = "github-dark-high-contrast"

[projects."{{ .chezmoi.homeDir }}/code/frame"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/nix-config"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"

[features]
hooks = true
memories = false
multi_agent_v2 = true

[features.code_mode]
enabled = true

[features.context_management]
experimental_mode = true
