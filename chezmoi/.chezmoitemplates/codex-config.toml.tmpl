approvals_reviewer = "user"
approval_policy = "never"
default_permissions = ":danger-full-access"
suppress_unstable_features_warning = true

[projects."{{ .chezmoi.homeDir }}/code/frame"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/nix-config"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"

[features]
hooks = true
memories = false
multi_agent_v2 = true

[features.code_mode]
enabled = true

[features.context_management]
experimental_mode = true

# The managed Executor server replaces the account-level connector, as in Claude
# Code; Google integrations stay off.
[plugins."executor@openai-curated-remote"]
enabled = false

[plugins."google-drive@openai-curated-remote"]
enabled = false
