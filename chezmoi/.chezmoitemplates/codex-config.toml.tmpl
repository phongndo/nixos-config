approvals_reviewer = "user"
approval_policy = "never"
default_permissions = ":danger-full-access"
suppress_unstable_features_warning = true

[projects."{{ .chezmoi.homeDir }}/code/frame"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/nix-config"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"

[features]
hooks = true
memories = false
multi_agent_v2 = true

[features.code_mode]
enabled = true

[features.context_management]
experimental_mode = true

# Account plugins take their on/off state from the ChatGPT account, so hide
# their apps locally instead: the managed Executor server replaces the account
# connector, as in Claude Code, and Google integrations stay off.
[apps.asdk_app_6acd465c1d148191832781c3c8ab4d99] # Executor
enabled = false

[apps.connector_5f3c8c41a1e54ad7a76272c89e2554fa] # Google Drive
enabled = false
