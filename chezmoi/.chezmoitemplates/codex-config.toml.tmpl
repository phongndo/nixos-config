model = "gpt-5.6-sol"
model_provider = "local-codex"
model_reasoning_effort = "high"
approvals_reviewer = "user"

# Shared by Codex App/CLI and T3 Code's default Codex provider.
[model_providers.local-codex]
name = "Local Codex proxy"
base_url = "http://127.0.0.1:8317/v1"
wire_api = "responses"

# Read the machine-local key at runtime; no GUI environment variable or copied secret.
[model_providers.local-codex.auth]
command = "/bin/sh"
args = ["-c", 'exec cat "$HOME/.cli-proxy-api/client-key"']

[projects."{{ .chezmoi.homeDir }}/code/lemma"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/nix-config"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"

[features]
hooks = true

[hooks.state]

[hooks.state."{{ .chezmoi.homeDir }}/.codex/hooks.json:session_start:0:0"]
trusted_hash = "sha256:1e5a59bb87ae3ffb373de26575badc6bdadb660ca2ce0759e531d7014c53b9d4"
