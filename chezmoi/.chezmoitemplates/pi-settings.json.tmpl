{{- /* Shared defaults for new settings; existing per-machine preferences win.
     Only packages are enforced by modify_settings.json. */ -}}
{
  "defaultThinkingLevel": "medium",
  "collapseChangelog": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "doubleEscapeAction": "tree",
  "theme": "origin",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "git:github.com/earendil-works/pi-review",
    "git:github.com/huggingface/pi-llama",
    "{{ .chezmoi.homeDir }}/code/pi-extensions"
  ],
  "treeFilterMode": "default",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "enableSkillCommands": true,
  "terminal": {
    "imageWidthCells": 60
  },
  "autocompleteMaxVisible": 10,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "tuiMode": "regular",
  "markdown": {
    "mermaid": "final"
  },
  "fullscreenExitOutput": "transcript",
  "defaultProvider": "local-codex",
  "defaultModel": "gpt-6-astra"
}
