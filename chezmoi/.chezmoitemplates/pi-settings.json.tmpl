{{- /* Shared defaults for new settings; existing per-machine preferences win.
     Only packages and shellPath are enforced by modify_settings.json. */ -}}
{
{{- /* +find/+grep: pi-fff overrides both in projects; in $HOME, where fff
       indexing is off, the built-ins keep search working. */}}
  "defaultTools": ["+codemode", "+find", "+grep"],
  "collapseChangelog": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "doubleEscapeAction": "tree",
  "theme": "origin",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "git:github.com/earendil-works/pi-review",
    "{{ .chezmoi.homeDir }}/code/pi-extensions"
  ],
{{- /* Claude Code and Codex get these skills from plugins; Pi has none. */}}
{{- if eq .chezmoi.os "darwin" }}
  "skills": ["{{ .chezmoi.homeDir }}/.agents/plugin-skills"],
{{- end }}
  "treeFilterMode": "default",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "enableSkillCommands": true,
  "terminal": {
    "imageWidthCells": 60
  },
  "autocompleteMaxVisible": 10,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "tuiMode": "regular",
  "markdown": {
    "mermaid": "final"
  },
  "fullscreenExitOutput": "transcript",
  "shellPath": "/etc/profiles/per-user/{{ .chezmoi.username }}/bin/bash",
{{- /* Load the project's direnv/nix-direnv environment for every bash call
       (~0.05-0.1 s cached), so commands rarely need `nix develop -c`. */}}
  "shellCommandPrefix": "eval \"$(direnv export bash 2>/dev/null)\""
}
