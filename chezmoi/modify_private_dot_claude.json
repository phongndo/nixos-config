#!/bin/sh
# Manage Executor and migrate the LLVM servers to the checkout. Preserve
# Claude's other state and its original formatting when nothing changes.
set -eu
current=$(mktemp)
trap 'rm -f "$current"' EXIT
cat >"$current"
jq="/etc/profiles/per-user/$(id -un)/bin/jq"
if [ ! -x "$jq" ]; then
  cat "$current"
  exit 0
fi
[ -s "$current" ] || printf '{}' >"$current"
command="$HOME/.local/bin/executor-token"
# shellcheck disable=SC2016
update='.mcpServers |= ((. // {}) + {executor: {type: "stdio", command: $command, args: ["mcp"]}} | del(.alive2, .godbolt))'
if "$jq" -e --arg command "$command" ". == ($update)" "$current" >/dev/null; then
  cat "$current"
else
  "$jq" --arg command "$command" "$update" "$current"
fi
