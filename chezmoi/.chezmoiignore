# Secrets, caches, and generated state are never managed by chezmoi.
# These patterns are guardrails so a future `chezmoi add` of a live agent
# directory cannot commit credentials or runtime state.
#
# Extension/skill/theme source lives in ~/code/pi-extensions. Do not
# chezmoi add ~/.pi/agent/{extensions,skills,themes}.
auth.json
*.sqlite*
*.sqlite-shm
*.sqlite-wal
*.log
*.sock
history.jsonl
session_index.jsonl
node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
cache/**
sessions/**
session-state/**
servers/**
.DS_Store
.migrated-from-dot-pi
models-store.json
trust.json
web-telemetry.jsonl
herdr-agent-state.*
herdr-tui-session.js

# Claude Code: only settings and the shared instructions are chezmoi-managed.
# Skills are distributed by sync-agent-skills, not copied from live state.
.claude.json
.claude/.credentials.json
.claude/settings.local.json
.claude/skills/**
.claude/backups/**
.claude/debug/**
.claude/downloads/**
.claude/file-history/**
.claude/paste-cache/**
.claude/plugins/**
.claude/projects/**
.claude/session-env/**
.claude/shell-snapshots/**
.claude/stats-cache.json
.claude/statsig/**
.claude/tasks/**
.claude/telemetry/**
.claude/todos/**

# Only the non-secret CLIProxyAPI template is managed; OAuth and the generated
# client/management keys and generated config are per-machine runtime state.
.cli-proxy-api/auth/**
.cli-proxy-api/client-key
.cli-proxy-api/management-key
.cli-proxy-api/static/**
.cli-proxy-api/config.json
.cli-proxy-api/config.lock
.cli-proxy-api/logs/**

# Only Linux needs the wrapper for its local Executor installation.
{{ if ne .chezmoi.os "linux" }}
.local/bin/executor-mcp
{{ end }}

# Machine keys are provisioned directly, never committed or synced.
.ssh/id_*

# Retired agent state must not be re-imported into the source tree.
.dsh/**
# Let .chezmoiremove remove the formerly managed patch.
!.dsh/cordis.patch.yml
