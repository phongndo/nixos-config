# Secrets, caches, and generated state are never managed by chezmoi.
# These patterns are guardrails so a future `chezmoi add` of a live agent
# directory cannot commit credentials or runtime state.
#
# Pi's extensions and themes live in ~/code/pi-extensions; shared skills live in
# dot_agents/exact_skills. Do not chezmoi add ~/.pi/agent/{extensions,skills,themes}.
auth.json
*.sqlite*
*.sqlite-shm
*.sqlite-wal
*.log
*.sock
history.jsonl
session_index.jsonl
node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
cache/**
sessions/**
session-state/**
servers/**
.DS_Store
models-store.json
trust.json
web-telemetry.jsonl

# Claude Code: only settings, the Executor entry in ~/.claude.json, and the
# shared instructions are chezmoi-managed. run_after_link-claude-skills.sh
# links the shared skills into its skill folder.
.claude/.credentials.json
.claude/settings.local.json
.claude/skills/**
.claude/backups/**
.claude/debug/**
.claude/downloads/**
.claude/file-history/**
.claude/paste-cache/**
.claude/plugins/**
.claude/projects/**
.claude/session-env/**
.claude/shell-snapshots/**
.claude/stats-cache.json
.claude/statsig/**
.claude/tasks/**
.claude/telemetry/**
.claude/todos/**

# Rex installs and updates its own skill in the shared skill folder.
.agents/skills/rex

# Machine keys are provisioned directly, never committed or synced.
.ssh/id_*

# Linux uses the Rex CLI from its Nix package; only macOS needs the app wrapper.
{{ if ne .chezmoi.os "darwin" }}
.local/bin/rex
{{ end }}

# Retired agent state must not be re-imported into the source tree.
.dsh/**
.fx/**
